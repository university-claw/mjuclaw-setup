# ── Discord / AI ───────────────────────────────────────────────
DISCORD_BOT_TOKEN=your_discord_bot_token
GEMINI_API_KEY=your_gemini_api_key
OPENCLAW_MODEL=gemma-4-31b-it
DISCORD_SERVER_ID=1492100109997969499
DISCORD_USER_ID=415349075274104832
VIEW_PORT=3001
VIEW_BASE_URL=https://your-domain.ngrok-free.dev

# ── 호스트 Postgres (mju-public-data-worker가 쓰고, mju-news가 읽는 DB) ──
# 에이전트 컨테이너는 host.docker.internal 로 호스트에 접근한다.
# macOS/Windows Docker Desktop은 기본 지원, Linux는 docker-compose의 extra_hosts 참고.
PGHOST=host.docker.internal
PGPORT=5432
PGDATABASE=mjuclaw
PGUSER=mjuclaw_app
PGPASSWORD=change-me
PGSCHEMA=public_data

# ── 사용자 데이터(크리덴셜/프로필/세션) 저장 설정 ─────────────────
# 기본은 postgres. 컨테이너 재생성/백업/멀티 인스턴스 대비를 위해
# Discord user id 당 자산을 user_data 스키마로 저장한다.
# 로컬 단독 사용자는 MJU_STORAGE=file 로 내려 keyring/파일 vault 경로를 쓸 수 있다.
MJU_STORAGE=postgres

# user_data 스키마 전용 ROLE. 반드시 worker용 PGUSER 와 분리해야 한다.
# worker ROLE (mjuclaw_app) 은 user_data 스키마에 GRANT 가 없어야 하고,
# 이 ROLE 은 public_data 에 GRANT 가 없어야 한다.
# 같은 클러스터/DB 를 공유하므로 MJU_PGHOST/PORT/DATABASE 는 위의 PG* 와 보통 동일.
MJU_PGHOST=host.docker.internal
MJU_PGPORT=5432
MJU_PGDATABASE=mjuclaw
MJU_PGUSER=mjuclaw_user_app
MJU_PGPASSWORD=change-me
MJU_PGSCHEMA=user_data

# credentials envelope 암호화에 쓰는 32-byte 키 (hex 64글자).
#   openssl rand -hex 32
# 로 생성한다. 이 키를 잃어버리면 저장된 SSO 비번을 복호화할 수 없으니
# password manager / docker secret 에 반드시 백업해 둔다.
MJU_VAULT_KEY=replace-me-with-openssl-rand-hex-32

# worker가 저장한 공지 첨부/본문 이미지 원본 디렉토리 (호스트 경로).
# 에이전트 컨테이너에 read-only로 마운트된다 (컨테이너 내부 경로: /data/assets).
# 예: /Users/kbsoo/Codes/projects/mjuclaw/.data/assets
STORAGE_LOCAL_ROOT=/absolute/path/to/mjuclaw-workspace/.data/assets
