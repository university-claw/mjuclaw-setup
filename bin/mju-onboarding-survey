#!/bin/bash
# mju-onboarding-survey: 로그인 직후 Discord Poll로 알림 선호 수집.
#
# LLM이 파싱/분기에 개입하지 않는다. 에이전트는 start 호출만 보고,
# 결과 수거(collect)는 openclaw 크론이 주기적으로 돌린다.
#
# Usage:
#   mju-onboarding-survey start <discord_id>
#   mju-onboarding-survey collect <discord_id>     # cron 내부용
#   mju-onboarding-survey status <discord_id>
#   mju-onboarding-survey reset <discord_id>       # 재설문용
#
# 세션 상태: /data/users/<id>/onboarding-survey.json
#   { state: awaiting|applied|skipped|timeout-applied,
#     startedAt, channelId, expiryAt,
#     polls: { time: {messageId, choice}, categories: {messageId, choices[]} },
#     preset: {id, sources[]} | null }
#
# 재설문 방지 플래그: /data/users/<id>/onboarding-news-prompt.json
#   { promptedAt, outcome }

set -euo pipefail

CMD="${1-}"
if [[ -n "$CMD" ]]; then shift; fi

user_dir()        { printf '/data/users/%s\n' "$1"; }
session_file()    { printf '%s/onboarding-survey.json\n' "$(user_dir "$1")"; }
prompt_file()     { printf '%s/onboarding-news-prompt.json\n' "$(user_dir "$1")"; }
collect_job()     { printf 'onboarding-collect-%s\n' "$1"; }
collect_job_late(){ printf 'onboarding-collect-late-%s\n' "$1"; }

usage() {
  cat <<EOF
Usage:
  mju-onboarding-survey start <discord_id>
  mju-onboarding-survey collect <discord_id>
  mju-onboarding-survey status <discord_id>
  mju-onboarding-survey reset <discord_id>
EOF
}

# --- 프리셋 정의 (mju-news-alert preset 과 동일 id 체계) -------------
# time answer_id → preset_id
time_preset_for() {
  case "$1" in
    1) echo 'morning-daily' ;;
    2) echo 'weekday-morning' ;;
    3) echo 'evening-daily' ;;
    4) echo 'weekly-monday' ;;
    5) echo 'skip' ;;
    *) return 1 ;;
  esac
}

# category answer_id → source name
cat_source_for() {
  case "$1" in
    1) echo 'general' ;;
    2) echo 'scholarship' ;;
    3) echo 'event' ;;
    4) echo 'career' ;;
    *) return 1 ;;
  esac
}

TIME_QUESTION='🔔 학교 공지 알림을 언제 받을까요? (1시간 안에 투표 안 하면 매일 아침 8시로 자동 설정)'
TIME_OPTIONS=(
  '아침 8시 매일'
  '평일 아침 8시'
  '저녁 9시 매일'
  '월요일 9시 주1회'
  '알림 안 받기'
)

CAT_QUESTION='📂 어떤 공지 받을래요? (여러 개 선택 가능 / 아무것도 안 고르면 전체)'
CAT_OPTIONS=(
  '일반공지'
  '장학/학자금'
  '행사/이벤트'
  '진로/취업'
)

# --- 유틸: DM 채널 id 얻기 (message send가 반환) -----------------------
get_dm_channel_id() {
  local discord_id="$1"
  # 빈 ping 메시지로 channelId를 캐시한다. 내용은 유저에게 보이지 않게 공백 한 칸.
  # 실패하면 비워둔 채 exit 1.
  local resp
  if ! resp=$(openclaw message send --channel discord --target "user:$discord_id" --message "." --silent --json 2>&1); then
    echo "ERR: get_dm_channel_id send failed: $resp" >&2
    return 1
  fi
  local channel_id
  channel_id=$(RESP_JSON="$resp" python3 - <<'PY'
import json, os, sys
try:
    p = json.loads(os.environ["RESP_JSON"])
    print(p.get("payload", {}).get("result", {}).get("channelId", ""))
except Exception as e:
    print("", file=sys.stderr)
    sys.exit(0)
PY
)
  if [[ -z "$channel_id" ]]; then
    echo "ERR: no channelId in send response" >&2
    return 1
  fi
  # 같은 턴에 보낸 ping 메시지 ID도 함께 반환해 뒤에서 delete 가능하도록.
  local ping_id
  ping_id=$(RESP_JSON="$resp" python3 - <<'PY'
import json, os
p = json.loads(os.environ["RESP_JSON"])
print(p.get("payload", {}).get("result", {}).get("messageId", ""))
PY
)
  echo "$channel_id|$ping_id"
}

# --- 유틸: 최근 메시지 중 poll.question이 일치하는 첫 id 반환 ----------
find_poll_message_id() {
  local channel_id="$1"
  local question="$2"
  local resp
  if ! resp=$(openclaw message read --channel discord --target "channel:$channel_id" --limit 5 --json 2>&1); then
    echo "ERR: read failed: $resp" >&2
    return 1
  fi
  RESP_JSON="$resp" QUESTION="$question" python3 - <<'PY'
import json, os, sys
resp = json.loads(os.environ["RESP_JSON"])
target_q = os.environ["QUESTION"]
msgs = resp.get("payload", {}).get("messages", []) or []
for m in msgs:
    poll = m.get("poll")
    if poll and (poll.get("question") or {}).get("text") == target_q:
        print(m.get("id", ""))
        sys.exit(0)
print("")
sys.exit(0)
PY
}

# --- start ------------------------------------------------------------
cmd_start() {
  local discord_id="$1"
  [[ -z "$discord_id" ]] && { usage; exit 1; }
  if ! [[ "$discord_id" =~ ^[0-9]{17,20}$ ]]; then
    echo "ERR: invalid discord id" >&2
    exit 2
  fi

  local udir
  udir=$(user_dir "$discord_id")
  mkdir -p "$udir"

  local sf pf
  sf=$(session_file "$discord_id")
  pf=$(prompt_file "$discord_id")

  # 이미 한 번 물어봤거나, 현재 세션이 진행중이면 skip (멱등).
  if [[ -f "$pf" ]] || [[ -f "$sf" ]]; then
    if [[ -f "$sf" ]]; then
      cat "$sf"
    else
      cat "$pf"
    fi
    exit 0
  fi

  # DM 채널 id + 임시 ping 메시지 id.
  local ch_and_ping channel_id ping_id
  if ! ch_and_ping=$(get_dm_channel_id "$discord_id"); then
    echo '{"state":"error","reason":"dm_channel_lookup_failed"}'
    exit 1
  fi
  channel_id="${ch_and_ping%%|*}"
  ping_id="${ch_and_ping#*|}"

  # ping 메시지 정리 (유저 DM 스팸 방지)
  if [[ -n "$ping_id" ]]; then
    openclaw message delete --channel discord --target "channel:$channel_id" --message-id "$ping_id" >/dev/null 2>&1 || true
  fi

  # 웰컴 카드 (기능 요약 + 투표 안내). 출석 알림은 이미 자동 등록됐다는 점 강조.
  local welcome_body
  welcome_body=$(cat <<'EOF'
🦁 **환영합니다!** 이제 학사 서비스를 바로 쓸 수 있어요.

**할 수 있는 것들**
• 과제·강의공지·온라인강의 체크 (LMS)
• 출석 현황, 성적, 시간표 (UCheck/MSI)
• 도서 검색·대출 현황 (도서관)
• 학식 메뉴, 학교 공지

**이미 켜진 알림**
• 수업 시작 후 출석 체크 누락 시 DM (자동)

**선택 알림 — 아래 2개 투표로 결정해주세요**
학교 공지 선제 알림을 어떻게 받을지 골라주시면 바로 등록해요.
(1시간 안에 답 없으면 기본값 "매일 아침 8시 · 전체"로 자동 설정됩니다.)
EOF
)

  openclaw message send --channel discord --target "user:$discord_id" --message "$welcome_body" >/dev/null || true

  # Poll 1: time (single-select)
  local poll1_args=(openclaw message poll --channel discord --target "user:$discord_id"
    --poll-question "$TIME_QUESTION" --poll-duration-hours 1)
  for opt in "${TIME_OPTIONS[@]}"; do poll1_args+=(--poll-option "$opt"); done
  if ! "${poll1_args[@]}" >/dev/null; then
    echo '{"state":"error","reason":"poll_time_send_failed"}'
    exit 1
  fi
  local time_msg_id
  time_msg_id=$(find_poll_message_id "$channel_id" "$TIME_QUESTION" 2>/dev/null || true)

  # Poll 2: categories (multi-select)
  local poll2_args=(openclaw message poll --channel discord --target "user:$discord_id"
    --poll-question "$CAT_QUESTION" --poll-duration-hours 1 --poll-multi)
  for opt in "${CAT_OPTIONS[@]}"; do poll2_args+=(--poll-option "$opt"); done
  if ! "${poll2_args[@]}" >/dev/null; then
    echo '{"state":"error","reason":"poll_category_send_failed"}'
    exit 1
  fi
  local cat_msg_id
  cat_msg_id=$(find_poll_message_id "$channel_id" "$CAT_QUESTION" 2>/dev/null || true)

  # 세션 파일 저장
  CHANNEL_ID="$channel_id" TIME_MSG="$time_msg_id" CAT_MSG="$cat_msg_id" SESSION_FILE="$sf" python3 - <<'PY'
import json, os
from datetime import datetime, timezone, timedelta
now = datetime.now(timezone.utc)
state = {
    "state": "awaiting",
    "startedAt": now.isoformat(),
    "expiryAt": (now + timedelta(hours=1, minutes=1)).isoformat(),
    "channelId": os.environ["CHANNEL_ID"],
    "polls": {
        "time":       {"messageId": os.environ.get("TIME_MSG") or None, "choice": None},
        "categories": {"messageId": os.environ.get("CAT_MSG") or None, "choices": []},
    },
    "preset": None,
}
with open(os.environ["SESSION_FILE"], "w", encoding="utf-8") as f:
    json.dump(state, f, ensure_ascii=False, indent=2)
PY

  # 수거 cron 2건 등록: 즉시 반응용(+3m) + 만료 백업(+65m)
  # 둘 다 one-shot(delete-after-run). 에이전트는 --tools exec 로 명령만 실행.
  local deliver_cmd
  printf -v deliver_cmd 'mju-onboarding-survey collect %q' "$discord_id"
  local msg
  msg="다음을 정확히 실행: exec로 ${deliver_cmd} 를 실행하고, 추가 명령 없이 <final></final>로 종료."

  openclaw cron rm "$(collect_job "$discord_id")" >/dev/null 2>&1 || true
  openclaw cron rm "$(collect_job_late "$discord_id")" >/dev/null 2>&1 || true

  openclaw cron add \
    --name "$(collect_job "$discord_id")" \
    --at "3m" \
    --session isolated \
    --message "$msg" \
    --no-deliver \
    --tools "exec" \
    --timeout-seconds 60 \
    --delete-after-run >/dev/null || true

  openclaw cron add \
    --name "$(collect_job_late "$discord_id")" \
    --at "65m" \
    --session isolated \
    --message "$msg" \
    --no-deliver \
    --tools "exec" \
    --timeout-seconds 60 \
    --delete-after-run >/dev/null || true

  cat "$sf"
}

# --- collect ----------------------------------------------------------
# 두 poll을 한 번에 스캔. 투표가 충분히 들어왔거나 만료되면 프리셋을 적용하고
# 세션을 종료한다. 여전히 대기중이면 no-op.
cmd_collect() {
  local discord_id="$1"
  [[ -z "$discord_id" ]] && { usage; exit 1; }
  local sf pf
  sf=$(session_file "$discord_id")
  pf=$(prompt_file "$discord_id")

  if [[ ! -f "$sf" ]]; then
    echo '{"state":"none"}'
    exit 0
  fi

  # 이미 종결된 세션이면 그냥 반환
  local cur_state
  cur_state=$(SF="$sf" python3 -c 'import json,os; print(json.load(open(os.environ["SF"])).get("state",""))')
  if [[ "$cur_state" != "awaiting" ]]; then
    cat "$sf"
    exit 0
  fi

  local channel_id
  channel_id=$(SF="$sf" python3 -c 'import json,os; print(json.load(open(os.environ["SF"])).get("channelId",""))')
  if [[ -z "$channel_id" ]]; then
    echo "ERR: session has no channelId" >&2
    exit 1
  fi

  # DM 채널 최신 메시지 20건에서 해당 poll 두 건을 찾아 결과 집계.
  local resp
  if ! resp=$(openclaw message read --channel discord --target "channel:$channel_id" --limit 25 --json 2>&1); then
    echo "ERR: read failed: $resp" >&2
    exit 1
  fi

  RESP_JSON="$resp" SESSION_FILE="$sf" PROMPT_FILE="$pf" DISCORD_ID="$discord_id" \
    TIME_Q="$TIME_QUESTION" CAT_Q="$CAT_QUESTION" python3 - <<'PY'
import json, os, subprocess, sys
from datetime import datetime, timezone

sf = os.environ["SESSION_FILE"]
pf = os.environ["PROMPT_FILE"]
with open(sf, encoding="utf-8") as f:
    state = json.load(f)

resp = json.loads(os.environ["RESP_JSON"])
msgs = resp.get("payload", {}).get("messages", []) or []

def find_poll(question_text):
    for m in msgs:
        poll = m.get("poll")
        if poll and (poll.get("question") or {}).get("text") == question_text:
            return m, poll
    return None, None

_, time_poll = find_poll(os.environ["TIME_Q"])
_, cat_poll  = find_poll(os.environ["CAT_Q"])

def voted_ids(poll):
    if not poll:
        return [], False
    results = poll.get("results") or {}
    counts = results.get("answer_counts") or []
    finalized = bool(results.get("is_finalized"))
    chosen = [c["id"] for c in counts if (c.get("count") or 0) >= 1]
    return chosen, finalized

time_choices, time_final = voted_ids(time_poll)
cat_choices,  cat_final  = voted_ids(cat_poll)

# 만료 체크 (서버 시계 기준)
expiry = state.get("expiryAt")
expired = False
if expiry:
    try:
        dt = datetime.fromisoformat(expiry.replace("Z", "+00:00"))
        expired = datetime.now(timezone.utc) >= dt
    except Exception:
        expired = False

# 종결 조건:
#  - time poll에 표가 있으면 즉시 종결 (그 선택 적용)
#  - 둘 다 finalized 이거나 전체 만료면 종결
decision = None
if time_choices:
    decision = "voted"
elif time_final and cat_final:
    decision = "finalized"
elif expired:
    decision = "timeout"

if decision is None:
    # 여전히 대기중. 아무것도 안 함.
    print(json.dumps({"state":"awaiting","pollsSeen": bool(time_poll and cat_poll)}, ensure_ascii=False))
    sys.exit(0)

# preset 결정
TIME_PRESETS = {
    1: "morning-daily",
    2: "weekday-morning",
    3: "evening-daily",
    4: "weekly-monday",
    5: "skip",
}
CAT_SOURCES = {1: "general", 2: "scholarship", 3: "event", 4: "career"}

if time_choices:
    preset = TIME_PRESETS.get(time_choices[0], "morning-daily")
else:
    # 만료/finalized 후 표가 없으면 기본값.
    preset = "morning-daily"

sources = [CAT_SOURCES[i] for i in cat_choices if i in CAT_SOURCES]
sources_csv = ",".join(sources)

# mju-news-alert preset 호출
r = subprocess.run(
    ["mju-news-alert", "preset", os.environ["DISCORD_ID"], preset, sources_csv],
    capture_output=True, text=True,
)
apply_ok = r.returncode == 0
apply_msg = (r.stdout or r.stderr or "").strip()

# 상태 전이
if decision == "timeout":
    state["state"] = "timeout-applied"
elif preset == "skip":
    state["state"] = "skipped"
else:
    state["state"] = "applied"

state["polls"]["time"]["choice"] = time_choices[0] if time_choices else None
state["polls"]["categories"]["choices"] = cat_choices
state["preset"] = {"id": preset, "sources": sources, "applyOk": apply_ok, "applyMsg": apply_msg}
state["closedAt"] = datetime.now(timezone.utc).isoformat()

with open(sf, "w", encoding="utf-8") as f:
    json.dump(state, f, ensure_ascii=False, indent=2)

# 재질문 방지 플래그
with open(pf, "w", encoding="utf-8") as f:
    json.dump({
        "promptedAt": state.get("startedAt"),
        "closedAt": state["closedAt"],
        "outcome": state["state"],
        "preset": preset,
        "sources": sources,
    }, f, ensure_ascii=False, indent=2)

# 유저에게 확인 DM
if preset == "skip":
    confirm = "🔕 알림을 받지 않기로 하셨어요. 나중에 바꾸고 싶으면 '알림 설정 다시'라고 말씀해주세요."
else:
    pretty_time = {
        "morning-daily": "매일 아침 8시",
        "weekday-morning": "평일 아침 8시",
        "evening-daily": "매일 저녁 9시",
        "weekly-monday": "매주 월요일 아침 9시",
    }.get(preset, preset)
    pretty_cats = ", ".join(sources) if sources else "전체"
    prefix = "⏰ 기본값으로" if decision == "timeout" else "✅"
    confirm = f"{prefix} 공지 알림이 등록됐어요: **{pretty_time}** · 카테고리: **{pretty_cats}** 🦁"

subprocess.run(
    ["openclaw", "message", "send", "--channel", "discord",
     "--target", f"user:{os.environ['DISCORD_ID']}",
     "--message", confirm],
    check=False, capture_output=True, text=True,
)

print(json.dumps({"state": state["state"], "preset": preset, "sources": sources}, ensure_ascii=False))
PY
}

# --- status -----------------------------------------------------------
cmd_status() {
  local discord_id="$1"
  [[ -z "$discord_id" ]] && { usage; exit 1; }
  local sf pf
  sf=$(session_file "$discord_id")
  pf=$(prompt_file "$discord_id")
  if [[ -f "$sf" ]]; then
    cat "$sf"
  elif [[ -f "$pf" ]]; then
    cat "$pf"
  else
    echo '{"state":"none"}'
  fi
}

# --- reset ------------------------------------------------------------
cmd_reset() {
  local discord_id="$1"
  [[ -z "$discord_id" ]] && { usage; exit 1; }
  rm -f "$(session_file "$discord_id")" "$(prompt_file "$discord_id")"
  openclaw cron rm "$(collect_job "$discord_id")" >/dev/null 2>&1 || true
  openclaw cron rm "$(collect_job_late "$discord_id")" >/dev/null 2>&1 || true
  echo "OK: reset $discord_id"
}

case "$CMD" in
  start)   cmd_start   "${1-}" ;;
  collect) cmd_collect "${1-}" ;;
  status)  cmd_status  "${1-}" ;;
  reset)   cmd_reset   "${1-}" ;;
  *)       usage; exit 1 ;;
esac
