#!/bin/bash
# mju-onboarding-survey: 로그인 직후 Discord Poll로 알림 선호 수집.
#
# LLM이 파싱/분기에 개입하지 않는다. 에이전트는 start 호출만 보고,
# 결과 수거(collect)는 openclaw 크론이 주기적으로 돌린다.
#
# Discord 도메인 호출(메시지 전송, Poll 발사, 채널 조회, 메시지 삭제)은
# mjuclaw-router HTTP로 위임. agent는 Discord 토큰을 갖고 있지 않다
# (2026-05-03 데이터 누출 fix 이후 router 단독 소유).
#
# Usage:
#   mju-onboarding-survey start <discord_id>
#   mju-onboarding-survey collect <discord_id>     # cron 내부용
#   mju-onboarding-survey status <discord_id>
#   mju-onboarding-survey reset <discord_id>       # 재설문용
#
# 세션 상태: /data/users/<id>/onboarding-survey.json
#   { state: awaiting|applied|skipped|timeout-applied,
#     startedAt, channelId, expiryAt,
#     polls: { time: {messageId, choice}, categories: {messageId, choices[]} },
#     preset: {id, sources[]} | null }
#
# 재설문 방지 플래그: /data/users/<id>/onboarding-news-prompt.json
#   { promptedAt, outcome }

set -euo pipefail

CMD="${1-}"
if [[ -n "$CMD" ]]; then shift; fi

user_dir()        { printf '/data/users/%s\n' "$1"; }
session_file()    { printf '%s/onboarding-survey.json\n' "$(user_dir "$1")"; }
prompt_file()     { printf '%s/onboarding-news-prompt.json\n' "$(user_dir "$1")"; }
collect_job()     { printf 'onboarding-collect-%s\n' "$1"; }
collect_job_late(){ printf 'onboarding-collect-late-%s\n' "$1"; }

usage() {
  cat <<EOF
Usage:
  mju-onboarding-survey start <discord_id>
  mju-onboarding-survey collect <discord_id>
  mju-onboarding-survey status <discord_id>
  mju-onboarding-survey reset <discord_id>
EOF
}

TIME_QUESTION='🔔 학교 공지 알림을 언제 받을까요? (1시간 안에 투표 안 하면 매일 아침 8시로 자동 설정)'
TIME_OPTIONS=(
  '아침 8시 매일'
  '평일 아침 8시'
  '저녁 9시 매일'
  '월요일 9시 주1회'
  '알림 안 받기'
)

CAT_QUESTION='📂 어떤 공지 받을래요? (여러 개 선택 가능 / 아무것도 안 고르면 전체)'
CAT_OPTIONS=(
  '일반공지'
  '장학/학자금'
  '행사/이벤트'
  '진로/취업'
)

# Poll answer index(1-based) → preset/source id 매핑은 collect의 python 안에서.

# --- router HTTP 헬퍼 -------------------------------------------------
router_url()   { printf '%s' "${MJUCLAW_ROUTER_URL:-http://mjuclaw-router:3100}"; }
router_token() { printf '%s' "${MJUCLAW_ROUTER_TOKEN-}"; }

# router_call <method> <path-with-query> [json-body]  → stdout: response body
# 비-200 응답은 stderr로 에러 메시지 + return 1.
router_call() {
  local method="$1" path="$2" body="${3-}"
  local token
  token=$(router_token)
  if [[ -z "$token" ]]; then
    echo "ERR: MJUCLAW_ROUTER_TOKEN env가 비어있어 router 호출 불가" >&2
    return 1
  fi

  local url out code curl_args
  url="$(router_url)$path"
  out=$(mktemp "${TMPDIR:-/tmp}/router-call.XXXXXX")
  curl_args=(-sS -o "$out" -w "%{http_code}"
    -X "$method" "$url"
    -H "Authorization: Bearer $token"
    --max-time 30)
  if [[ -n "$body" ]]; then
    curl_args+=(-H "Content-Type: application/json" --data-raw "$body")
  fi

  code=$(curl "${curl_args[@]}" 2>/dev/null || echo "000")
  if [[ "$code" != "200" ]]; then
    local resp
    resp=$(cat "$out" 2>/dev/null || true)
    echo "ERR: $method $url → HTTP $code: ${resp:-<no body>}" >&2
    rm -f "$out"
    return 1
  fi
  cat "$out"
  rm -f "$out"
}

# router_send <discord_id> <content>  → stdout: response (channelId, messageId 포함)
router_send() {
  local discord_id="$1" content="$2"
  local body
  body=$(DISCORD_ID="$discord_id" CONTENT="$content" python3 - <<'PY'
import json, os
print(json.dumps({"discordUserId": os.environ["DISCORD_ID"], "content": os.environ["CONTENT"]}))
PY
)
  router_call POST "/discord/send" "$body"
}

# router_poll <discord_id> <question> <duration-hours> <multi:true|false> <opt1> [opt2 ...]
router_poll() {
  local discord_id="$1" question="$2" duration="$3" multi="$4"
  shift 4
  local body
  body=$(
    DISCORD_ID="$discord_id" QUESTION="$question" DURATION="$duration" MULTI="$multi" \
    OPTIONS_JSON=$(printf '%s\n' "$@" | python3 -c 'import json,sys; print(json.dumps([l.rstrip("\n") for l in sys.stdin if l.strip()]))') \
    python3 - <<'PY'
import json, os
answers = json.loads(os.environ["OPTIONS_JSON"])
print(json.dumps({
    "discordUserId": os.environ["DISCORD_ID"],
    "question": os.environ["QUESTION"],
    "answers": answers,
    "durationHours": int(os.environ["DURATION"]),
    "allowMultiselect": os.environ["MULTI"] == "true",
}))
PY
)
  router_call POST "/discord/poll" "$body"
}

# router_list_messages <channel_id> <limit>  → stdout: response (messages[] with poll results)
router_list_messages() {
  local channel_id="$1" limit="$2"
  router_call GET "/discord/messages?channelId=${channel_id}&limit=${limit}" ""
}

# router_delete_message <channel_id> <message_id>
router_delete_message() {
  local channel_id="$1" message_id="$2"
  router_call DELETE "/discord/messages?channelId=${channel_id}&messageId=${message_id}" "" >/dev/null
}

# JSON에서 .channelId / .messageId 등 단일 필드 추출 (python3 의존)
json_field() {
  local json="$1" field="$2"
  printf '%s' "$json" | JSON_FIELD="$field" python3 -c '
import json, os, sys
try:
    d = json.load(sys.stdin)
    v = d.get(os.environ["JSON_FIELD"])
    print(v if v is not None else "")
except Exception:
    sys.exit(1)
'
}

# --- start ------------------------------------------------------------
cmd_start() {
  local discord_id="$1"
  [[ -z "$discord_id" ]] && { usage; exit 1; }
  if ! [[ "$discord_id" =~ ^[0-9]{17,20}$ ]]; then
    echo "ERR: invalid discord id" >&2
    exit 2
  fi

  local udir
  udir=$(user_dir "$discord_id")
  mkdir -p "$udir"

  local sf pf
  sf=$(session_file "$discord_id")
  pf=$(prompt_file "$discord_id")

  # 이미 한 번 물어봤거나, 현재 세션이 진행중이면 skip (멱등).
  if [[ -f "$pf" ]] || [[ -f "$sf" ]]; then
    if [[ -f "$sf" ]]; then cat "$sf"; else cat "$pf"; fi
    exit 0
  fi

  # 웰컴 카드 (기능 요약 + 투표 안내). 출석 알림은 이미 자동 등록됐다는 점 강조.
  local welcome_body
  welcome_body=$(cat <<'EOF'
🦁 **환영합니다!** 이제 학사 서비스를 바로 쓸 수 있어요.

**할 수 있는 것들**
• 과제·강의공지·온라인강의 체크 (LMS)
• 출석 현황, 성적, 시간표 (UCheck/MSI)
• 도서 검색·대출 현황 (도서관)
• 학식 메뉴, 학교 공지

**이미 켜진 알림**
• 수업 시작 후 출석 체크 누락 시 DM (자동)

**선택 알림 — 아래 2개 투표로 결정해주세요**
학교 공지 선제 알림을 어떻게 받을지 골라주시면 바로 등록해요.
(1시간 안에 답 없으면 기본값 "매일 아침 8시 · 전체"로 자동 설정됩니다.)
EOF
)

  local welcome_resp channel_id
  if ! welcome_resp=$(router_send "$discord_id" "$welcome_body"); then
    echo '{"state":"error","reason":"welcome_send_failed"}'
    exit 1
  fi
  channel_id=$(json_field "$welcome_resp" channelId)
  if [[ -z "$channel_id" ]]; then
    echo '{"state":"error","reason":"channel_id_missing"}'
    exit 1
  fi

  # Poll 1: time (single-select, 1시간 만료)
  local poll1_resp time_msg_id
  if ! poll1_resp=$(router_poll "$discord_id" "$TIME_QUESTION" 1 false "${TIME_OPTIONS[@]}"); then
    echo '{"state":"error","reason":"poll_time_send_failed"}'
    exit 1
  fi
  time_msg_id=$(json_field "$poll1_resp" messageId)

  # Poll 2: categories (multi-select, 1시간 만료)
  local poll2_resp cat_msg_id
  if ! poll2_resp=$(router_poll "$discord_id" "$CAT_QUESTION" 1 true "${CAT_OPTIONS[@]}"); then
    echo '{"state":"error","reason":"poll_category_send_failed"}'
    exit 1
  fi
  cat_msg_id=$(json_field "$poll2_resp" messageId)

  # 세션 파일 저장
  CHANNEL_ID="$channel_id" TIME_MSG="$time_msg_id" CAT_MSG="$cat_msg_id" SESSION_FILE="$sf" python3 - <<'PY'
import json, os
from datetime import datetime, timezone, timedelta
now = datetime.now(timezone.utc)
state = {
    "state": "awaiting",
    "startedAt": now.isoformat(),
    "expiryAt": (now + timedelta(hours=1, minutes=1)).isoformat(),
    "channelId": os.environ["CHANNEL_ID"],
    "polls": {
        "time":       {"messageId": os.environ.get("TIME_MSG") or None, "choice": None},
        "categories": {"messageId": os.environ.get("CAT_MSG") or None, "choices": []},
    },
    "preset": None,
}
with open(os.environ["SESSION_FILE"], "w", encoding="utf-8") as f:
    json.dump(state, f, ensure_ascii=False, indent=2)
PY

  # 수거 cron 2건 등록: 즉시 반응용(+3m) + 만료 백업(+65m)
  # 둘 다 one-shot(delete-after-run). 에이전트는 --tools exec 로 명령만 실행.
  local deliver_cmd
  printf -v deliver_cmd 'mju-onboarding-survey collect %q' "$discord_id"
  local msg
  msg="다음을 정확히 실행: exec로 ${deliver_cmd} 를 실행하고, 추가 명령 없이 <final></final>로 종료."

  openclaw cron rm "$(collect_job "$discord_id")" >/dev/null 2>&1 || true
  openclaw cron rm "$(collect_job_late "$discord_id")" >/dev/null 2>&1 || true

  openclaw cron add \
    --name "$(collect_job "$discord_id")" \
    --at "3m" \
    --session isolated \
    --message "$msg" \
    --no-deliver \
    --tools "exec" \
    --timeout-seconds 60 \
    --delete-after-run >/dev/null || true

  openclaw cron add \
    --name "$(collect_job_late "$discord_id")" \
    --at "65m" \
    --session isolated \
    --message "$msg" \
    --no-deliver \
    --tools "exec" \
    --timeout-seconds 60 \
    --delete-after-run >/dev/null || true

  cat "$sf"
}

# --- collect ----------------------------------------------------------
# 두 poll을 한 번에 스캔. 투표가 충분히 들어왔거나 만료되면 프리셋을 적용하고
# 세션을 종료한다. 여전히 대기중이면 no-op.
cmd_collect() {
  local discord_id="$1"
  [[ -z "$discord_id" ]] && { usage; exit 1; }
  local sf pf
  sf=$(session_file "$discord_id")
  pf=$(prompt_file "$discord_id")

  if [[ ! -f "$sf" ]]; then
    echo '{"state":"none"}'
    exit 0
  fi

  # 이미 종결된 세션이면 그냥 반환
  local cur_state
  cur_state=$(SF="$sf" python3 -c 'import json,os; print(json.load(open(os.environ["SF"])).get("state",""))')
  if [[ "$cur_state" != "awaiting" ]]; then
    cat "$sf"
    exit 0
  fi

  local channel_id
  channel_id=$(SF="$sf" python3 -c 'import json,os; print(json.load(open(os.environ["SF"])).get("channelId",""))')
  if [[ -z "$channel_id" ]]; then
    echo "ERR: session has no channelId" >&2
    exit 1
  fi

  # DM 채널 최신 메시지 25건에서 해당 poll 두 건을 찾아 결과 집계.
  local resp
  if ! resp=$(router_list_messages "$channel_id" 25); then
    echo "ERR: router list_messages 실패" >&2
    exit 1
  fi

  RESP_JSON="$resp" SESSION_FILE="$sf" PROMPT_FILE="$pf" DISCORD_ID="$discord_id" \
    TIME_Q="$TIME_QUESTION" CAT_Q="$CAT_QUESTION" python3 - <<'PY'
import json, os, subprocess, sys
from datetime import datetime, timezone

sf = os.environ["SESSION_FILE"]
pf = os.environ["PROMPT_FILE"]
with open(sf, encoding="utf-8") as f:
    state = json.load(f)

resp = json.loads(os.environ["RESP_JSON"])
msgs = resp.get("messages", []) or []

def find_poll(question_text):
    for m in msgs:
        poll = m.get("poll")
        if poll and (poll.get("question") or {}).get("text") == question_text:
            return m, poll
    return None, None

_, time_poll = find_poll(os.environ["TIME_Q"])
_, cat_poll  = find_poll(os.environ["CAT_Q"])

def voted_indices_1based(poll):
    """voteCount >= 1 인 answer를 1-based 순서로 반환.

    router /discord/messages 응답의 poll.answers 는 Discord 답변 순서대로 정렬되어
    오므로 enumerate index+1 가 곧 사용자가 본 1-based 선택 번호.
    """
    if not poll:
        return [], False
    answers = poll.get("answers") or []
    finalized = bool(poll.get("resultsFinalized"))
    chosen = [i + 1 for i, a in enumerate(answers) if (a.get("voteCount") or 0) >= 1]
    return chosen, finalized

time_choices, time_final = voted_indices_1based(time_poll)
cat_choices,  cat_final  = voted_indices_1based(cat_poll)

# 만료 체크 (서버 시계 기준)
expiry = state.get("expiryAt")
expired = False
if expiry:
    try:
        dt = datetime.fromisoformat(expiry.replace("Z", "+00:00"))
        expired = datetime.now(timezone.utc) >= dt
    except Exception:
        expired = False

# 종결 조건:
#  - time poll에 표가 있으면 즉시 종결 (그 선택 적용)
#  - 둘 다 finalized 이거나 전체 만료면 종결
decision = None
if time_choices:
    decision = "voted"
elif time_final and cat_final:
    decision = "finalized"
elif expired:
    decision = "timeout"

if decision is None:
    # 여전히 대기중. 아무것도 안 함.
    print(json.dumps({"state":"awaiting","pollsSeen": bool(time_poll and cat_poll)}, ensure_ascii=False))
    sys.exit(0)

# preset 결정
TIME_PRESETS = {
    1: "morning-daily",
    2: "weekday-morning",
    3: "evening-daily",
    4: "weekly-monday",
    5: "skip",
}
CAT_SOURCES = {1: "general", 2: "scholarship", 3: "event", 4: "career"}

if time_choices:
    preset = TIME_PRESETS.get(time_choices[0], "morning-daily")
else:
    # 만료/finalized 후 표가 없으면 기본값.
    preset = "morning-daily"

sources = [CAT_SOURCES[i] for i in cat_choices if i in CAT_SOURCES]
sources_csv = ",".join(sources)

# mju-news-alert preset 호출
r = subprocess.run(
    ["mju-news-alert", "preset", os.environ["DISCORD_ID"], preset, sources_csv],
    capture_output=True, text=True,
)
apply_ok = r.returncode == 0
apply_msg = (r.stdout or r.stderr or "").strip()

# 상태 전이
if decision == "timeout":
    state["state"] = "timeout-applied"
elif preset == "skip":
    state["state"] = "skipped"
else:
    state["state"] = "applied"

state["polls"]["time"]["choice"] = time_choices[0] if time_choices else None
state["polls"]["categories"]["choices"] = cat_choices
state["preset"] = {"id": preset, "sources": sources, "applyOk": apply_ok, "applyMsg": apply_msg}
state["closedAt"] = datetime.now(timezone.utc).isoformat()

with open(sf, "w", encoding="utf-8") as f:
    json.dump(state, f, ensure_ascii=False, indent=2)

# 재질문 방지 플래그
with open(pf, "w", encoding="utf-8") as f:
    json.dump({
        "promptedAt": state.get("startedAt"),
        "closedAt": state["closedAt"],
        "outcome": state["state"],
        "preset": preset,
        "sources": sources,
    }, f, ensure_ascii=False, indent=2)

# 유저에게 확인 DM (router HTTP 위임)
if preset == "skip":
    confirm = "🔕 알림을 받지 않기로 하셨어요. 나중에 바꾸고 싶으면 '알림 설정 다시'라고 말씀해주세요."
else:
    pretty_time = {
        "morning-daily": "매일 아침 8시",
        "weekday-morning": "평일 아침 8시",
        "evening-daily": "매일 저녁 9시",
        "weekly-monday": "매주 월요일 아침 9시",
    }.get(preset, preset)
    pretty_cats = ", ".join(sources) if sources else "전체"
    prefix = "⏰ 기본값으로" if decision == "timeout" else "✅"
    confirm = f"{prefix} 공지 알림이 등록됐어요: **{pretty_time}** · 카테고리: **{pretty_cats}** 🦁"

# router /discord/send 로 위임. 실패는 non-blocking.
import urllib.request, urllib.error
router_url = os.environ.get("MJUCLAW_ROUTER_URL", "http://mjuclaw-router:3100")
router_token = os.environ.get("MJUCLAW_ROUTER_TOKEN", "")
if router_token:
    body = json.dumps({"discordUserId": os.environ["DISCORD_ID"], "content": confirm}).encode("utf-8")
    req = urllib.request.Request(
        f"{router_url}/discord/send",
        data=body,
        headers={"Authorization": f"Bearer {router_token}", "Content-Type": "application/json"},
        method="POST",
    )
    try:
        urllib.request.urlopen(req, timeout=15)
    except Exception as exc:
        print(f"WARN: confirm DM 전송 실패: {exc}", file=sys.stderr)

print(json.dumps({"state": state["state"], "preset": preset, "sources": sources}, ensure_ascii=False))
PY
}

# --- status -----------------------------------------------------------
cmd_status() {
  local discord_id="$1"
  [[ -z "$discord_id" ]] && { usage; exit 1; }
  local sf pf
  sf=$(session_file "$discord_id")
  pf=$(prompt_file "$discord_id")
  if [[ -f "$sf" ]]; then
    cat "$sf"
  elif [[ -f "$pf" ]]; then
    cat "$pf"
  else
    echo '{"state":"none"}'
  fi
}

# --- reset ------------------------------------------------------------
cmd_reset() {
  local discord_id="$1"
  [[ -z "$discord_id" ]] && { usage; exit 1; }
  rm -f "$(session_file "$discord_id")" "$(prompt_file "$discord_id")"
  openclaw cron rm "$(collect_job "$discord_id")" >/dev/null 2>&1 || true
  openclaw cron rm "$(collect_job_late "$discord_id")" >/dev/null 2>&1 || true
  echo "OK: reset $discord_id"
}

case "$CMD" in
  start)   cmd_start   "${1-}" ;;
  collect) cmd_collect "${1-}" ;;
  status)  cmd_status  "${1-}" ;;
  reset)   cmd_reset   "${1-}" ;;
  *)       usage; exit 1 ;;
esac
