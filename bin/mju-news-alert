#!/bin/bash
# mju-news-alert: 유저별 뉴스 알림 구독 helper
#
# Usage:
#   mju-news-alert subscribe <discord_id> "<cron_expr>" "<sources>"
#   mju-news-alert preset <discord_id> <preset_id> [<sources>]
#   mju-news-alert unsubscribe <discord_id>
#   mju-news-alert status <discord_id>
#   mju-news-alert deliver <discord_id>     # cron이 호출 (내부용)
#
# sources: comma-separated from general,scholarship,event,career (빈 문자열이면 전부)
# preset_id: morning-daily | weekday-morning | evening-daily | weekly-monday | skip

set -euo pipefail

CMD="${1-}"
if [[ -n "$CMD" ]]; then
  shift
fi

usage() {
  cat <<EOF
Usage:
  mju-news-alert subscribe <discord_id> "<cron_expr>" "<sources>"
  mju-news-alert preset <discord_id> <preset_id> [<sources>]
  mju-news-alert unsubscribe <discord_id>
  mju-news-alert status <discord_id>
  mju-news-alert deliver <discord_id>

sources: general,scholarship,event,career (comma-separated, or "" for all)
preset_id: morning-daily | weekday-morning | evening-daily | weekly-monday | skip
EOF
}

# 프리셋 → cron 식 고정 매핑. survey 수거기와 자연어 폴백 모두 이 함수를 거친다.
preset_cron() {
  case "$1" in
    morning-daily)    echo '0 8 * * *' ;;
    weekday-morning)  echo '0 8 * * 1-5' ;;
    evening-daily)    echo '0 21 * * *' ;;
    weekly-monday)    echo '0 9 * * 1' ;;
    skip)             echo '' ;;
    *)                return 1 ;;
  esac
}

user_dir() { printf '/data/users/%s\n' "$1"; }
subs_file() { printf '%s/news-subscription.json\n' "$(user_dir "$1")"; }
job_name() { printf 'news-%s\n' "$1"; }

write_subscription_file() {
  local discord_id="$1"
  local cron_expr="$2"
  local sources="$3"
  local out_file="$4"
  local dir
  dir=$(dirname "$out_file")
  mkdir -p "$dir"

  local tmp_file
  tmp_file=$(mktemp "$dir/.news-subscription.XXXXXX")

  if ! DISCORD_ID="$discord_id" CRON_EXPR="$cron_expr" SOURCES="$sources" JOB_NAME="$(job_name "$discord_id")" TMP_FILE="$tmp_file" python3 - <<'PY'
import json
import os
from datetime import datetime, timezone

prefs = {
    "enabled": True,
    "cronExpr": os.environ["CRON_EXPR"],
    "timezone": "Asia/Seoul",
    "sources": [s for s in os.environ["SOURCES"].split(",") if s],
    "cronJobName": os.environ["JOB_NAME"],
    "subscribedAt": datetime.now(timezone.utc).isoformat(),
    "lastSentAt": None,
}

with open(os.environ["TMP_FILE"], "w", encoding="utf-8") as f:
    json.dump(prefs, f, indent=2, ensure_ascii=False)
PY
  then
    rm -f "$tmp_file"
    return 1
  fi

  mv "$tmp_file" "$out_file"
}

update_last_sent_at() {
  local file_path="$1"
  local dir
  dir=$(dirname "$file_path")
  local tmp_file
  tmp_file=$(mktemp "$dir/.news-subscription.XXXXXX")

  if ! FILE_PATH="$file_path" TMP_FILE="$tmp_file" python3 - <<'PY'
import json
import os
from datetime import datetime, timezone

with open(os.environ["FILE_PATH"], encoding="utf-8") as f:
    payload = json.load(f)

payload["lastSentAt"] = datetime.now(timezone.utc).isoformat()

with open(os.environ["TMP_FILE"], "w", encoding="utf-8") as f:
    json.dump(payload, f, indent=2, ensure_ascii=False)
PY
  then
    rm -f "$tmp_file"
    return 1
  fi

  mv "$tmp_file" "$file_path"
}

case "$CMD" in
  subscribe)
    DISCORD_ID="${1-}"
    CRON_EXPR="${2-}"
    SOURCES="${3-}"
    [[ -z "$DISCORD_ID" || -z "$CRON_EXPR" ]] && { usage; exit 1; }

    UDIR=$(user_dir "$DISCORD_ID")
    mkdir -p "$UDIR"

    if ! openclaw cron rm "$(job_name "$DISCORD_ID")" >/dev/null 2>&1; then
      :
    fi

    printf -v deliver_cmd 'mju-news-alert deliver %q' "$DISCORD_ID"
    MESSAGE="다음을 정확히 실행: exec로 $deliver_cmd 를 실행하고, 추가 명령 없이 <final></final>로 종료."

    if ! openclaw cron add \
      --name "$(job_name "$DISCORD_ID")" \
      --cron "$CRON_EXPR" \
      --tz "Asia/Seoul" \
      --session isolated \
      --message "$MESSAGE" \
      --no-deliver \
      --tools "exec" \
      --timeout-seconds 90 >/dev/null; then
      echo "ERR: failed to register news alert cron for $DISCORD_ID" >&2
      exit 1
    fi

    if ! write_subscription_file "$DISCORD_ID" "$CRON_EXPR" "$SOURCES" "$(subs_file "$DISCORD_ID")"; then
      openclaw cron rm "$(job_name "$DISCORD_ID")" >/dev/null 2>&1 || true
      echo "ERR: failed to write subscription state for $DISCORD_ID" >&2
      exit 1
    fi

    echo "OK: subscribed $DISCORD_ID to $CRON_EXPR"
    ;;

  preset)
    DISCORD_ID="${1-}"
    PRESET_ID="${2-}"
    SOURCES="${3-}"
    [[ -z "$DISCORD_ID" || -z "$PRESET_ID" ]] && { usage; exit 1; }

    if ! CRON_EXPR=$(preset_cron "$PRESET_ID"); then
      echo "ERR: unknown preset '$PRESET_ID'" >&2
      exit 1
    fi

    if [[ "$PRESET_ID" == "skip" ]]; then
      # skip 프리셋: 기존 구독만 제거하고 subscription 파일은 남기지 않는다.
      openclaw cron rm "$(job_name "$DISCORD_ID")" >/dev/null 2>&1 || true
      rm -f "$(subs_file "$DISCORD_ID")"
      echo "OK: preset skip applied for $DISCORD_ID (no subscription)"
      exit 0
    fi

    exec "$0" subscribe "$DISCORD_ID" "$CRON_EXPR" "$SOURCES"
    ;;

  unsubscribe)
    DISCORD_ID="${1-}"
    [[ -z "$DISCORD_ID" ]] && { usage; exit 1; }
    openclaw cron rm "$(job_name "$DISCORD_ID")" >/dev/null 2>&1 || true
    rm -f "$(subs_file "$DISCORD_ID")"
    echo "OK: unsubscribed $DISCORD_ID"
    ;;

  status)
    DISCORD_ID="${1-}"
    [[ -z "$DISCORD_ID" ]] && { usage; exit 1; }
    F=$(subs_file "$DISCORD_ID")
    if [[ -f "$F" ]]; then
      cat "$F"
    else
      echo '{"enabled":false}'
    fi
    ;;

  deliver)
    DISCORD_ID="${1-}"
    [[ -z "$DISCORD_ID" ]] && { usage; exit 1; }
    F=$(subs_file "$DISCORD_ID")
    [[ ! -f "$F" ]] && { echo "신규 공지 없음"; exit 0; }

    SINCE=$(FILE_PATH="$F" python3 - <<'PY'
import json
import os
from datetime import datetime, timezone, timedelta

with open(os.environ["FILE_PATH"], encoding="utf-8") as f:
    payload = json.load(f)

last = payload.get("lastSentAt")
if last:
    print(last)
else:
    print((datetime.now(timezone.utc) - timedelta(hours=24)).isoformat())
PY
)

    SOURCES=$(FILE_PATH="$F" python3 - <<'PY'
import json
import os

with open(os.environ["FILE_PATH"], encoding="utf-8") as f:
    payload = json.load(f)

print(",".join(payload.get("sources", [])))
PY
)

    # v2.0.0: `new --since` → `notices recent --since`.
    # 카테고리 구독자는 CLI 레벨에서 `--category`를 내려 각 카테고리별로 독립 조회해야
    # "general 50건에 묻힌 scholarship" 같은 누락이 안 생긴다 (issue #4 High-1).
    # 조회 실패는 반드시 exit 1로 전파 — 빈 배열 fallback은 장애를 성공으로 위장한다 (issue #4 High-2).
    STDERR_FILE=$(mktemp "${TMPDIR:-/tmp}/mju-news-alert-stderr.XXXXXX")
    trap 'rm -f "$STDERR_FILE"' EXIT

    if [[ -z "$SOURCES" ]]; then
      categories=("")   # 빈 원소 하나 = 카테고리 필터 없이 한 번만 호출
    else
      IFS=',' read -ra categories <<< "$SOURCES"
    fi

    # 카테고리 수에 비례해 limit을 조정. 단일 전체 조회일 땐 50, 카테고리별이면 각 30건.
    if [[ -z "$SOURCES" ]]; then
      per_call_limit=50
    else
      per_call_limit=30
    fi

    ALL_ITEMS='[]'
    for cat in "${categories[@]}"; do
      if [[ -z "$cat" ]]; then
        mju_args=(notices recent --since "$SINCE" --limit "$per_call_limit" --format json)
      else
        mju_args=(notices recent --category "$cat" --since "$SINCE" --limit "$per_call_limit" --format json)
      fi

      if ! RESULT=$(mju-news "${mju_args[@]}" 2>"$STDERR_FILE"); then
        stderr_text=$(cat "$STDERR_FILE" 2>/dev/null || true)
        echo "ERR: mju-news-alert[$DISCORD_ID] fetch failed (category='${cat:-all}'): ${stderr_text:-<no stderr>}" >&2
        exit 1
      fi

      ALL_ITEMS=$(RESULT_JSON="$RESULT" ACCUM_JSON="$ALL_ITEMS" python3 - <<'PY'
import json
import os

accum = json.loads(os.environ["ACCUM_JSON"])
items = json.loads(os.environ["RESULT_JSON"]).get("items", [])
accum.extend(items)
print(json.dumps(accum, ensure_ascii=False))
PY
)
    done

    CONTENT=$(ITEMS_JSON="$ALL_ITEMS" python3 - <<'PY'
import json
import os
import sys

items = json.loads(os.environ["ITEMS_JSON"])

# 카테고리별 호출 병합 결과에 혹시 남아있을 수 있는 중복(id 기준) 제거.
seen = set()
deduped = []
for item in items:
    key = item.get("id") or (item.get("source"), item.get("externalId"))
    if key in seen:
        continue
    seen.add(key)
    deduped.append(item)
items = deduped

# 최신순 정렬 (publishedAt desc). 빠진 필드 방어.
items.sort(key=lambda it: it.get("publishedAt", ""), reverse=True)

if not items:
    print("신규 공지 없음")
    sys.exit(0)

label = {
    "general": "📢 일반공지",
    "scholarship": "💰 장학/학자금공지",
    "event": "🎉 행사공지",
    "career": "💼 진로/취업공지",
}

by_source = {}
for item in items:
    by_source.setdefault(item.get("source", ""), []).append(item)

lines = [f"🦁 새 학교 공지 {len(items)}건"]
for source, group in by_source.items():
    lines.append("")
    lines.append(f"**{label.get(source, source)}** ({len(group)}건)")
    for notice in group[:5]:
        title = notice.get("title", "")
        url = notice.get("url", "")
        lines.append(f"- [{title}]({url})")

print("\n".join(lines))
PY
)

    if [[ "$CONTENT" == "신규 공지 없음" || -z "$CONTENT" ]]; then
      echo "신규 공지 없음"
      exit 0
    fi

    if ! openclaw message send --channel discord --target "user:$DISCORD_ID" --message "$CONTENT"; then
      echo "ERR: failed to deliver news alert to $DISCORD_ID" >&2
      exit 1
    fi

    if ! update_last_sent_at "$F"; then
      echo "ERR: delivered news alert but failed to update lastSentAt" >&2
      exit 1
    fi

    printf '%s\n' "$CONTENT"
    ;;

  *)
    usage
    exit 1
    ;;
esac
