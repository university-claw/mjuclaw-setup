#!/bin/bash
# mju-news-alert: 유저별 뉴스 알림 구독 helper
#
# Usage:
#   mju-news-alert subscribe <discord_id> "<cron_expr>" "<sources>"
#   mju-news-alert preset <discord_id> <preset_id> [<sources>]
#   mju-news-alert unsubscribe <discord_id>
#   mju-news-alert status <discord_id>
#   mju-news-alert deliver <discord_id>     # cron이 호출 (내부용)
#
# sources: comma-separated from general,scholarship,event,career (빈 문자열이면 전부)
# preset_id: morning-daily | weekday-morning | evening-daily | weekly-monday | skip

set -euo pipefail

CMD="${1-}"
if [[ -n "$CMD" ]]; then
  shift
fi

usage() {
  cat <<EOF
Usage:
  mju-news-alert subscribe <discord_id> "<cron_expr>" "<sources>"
  mju-news-alert preset <discord_id> <preset_id> [<sources>]
  mju-news-alert unsubscribe <discord_id>
  mju-news-alert status <discord_id>
  mju-news-alert deliver <discord_id>

sources: general,scholarship,event,career (comma-separated, or "" for all)
preset_id: morning-daily | weekday-morning | evening-daily | weekly-monday | skip
EOF
}

# 프리셋 → cron 식 고정 매핑. survey 수거기와 자연어 폴백 모두 이 함수를 거친다.
preset_cron() {
  case "$1" in
    morning-daily)    echo '0 8 * * *' ;;
    weekday-morning)  echo '0 8 * * 1-5' ;;
    evening-daily)    echo '0 21 * * *' ;;
    weekly-monday)    echo '0 9 * * 1' ;;
    skip)             echo '' ;;
    *)                return 1 ;;
  esac
}

user_dir() { printf '/data/users/%s\n' "$1"; }
subs_file() { printf '%s/news-subscription.json\n' "$(user_dir "$1")"; }
job_name() { printf 'news-%s\n' "$1"; }

# subscribe/preset/unsubscribe를 user 단위로 직렬화. 같은 사용자에 대해 두 호출이
# 동시에 진입하면 둘 다 cron list에서 0개를 보고 둘 다 add → 같은 name cron 2개 등록.
# 운영 중 실측됨 (news-415349075274104832 schedule "0 8 * * *" 가 2개 동시 존재).
# 30초 대기 후 못 잡으면 abort — 누적 등록보다 명시적 실패가 낫다.
acquire_user_lock() {
  local lock_dir lock_file
  lock_dir=$(user_dir "$1")
  mkdir -p "$lock_dir"
  lock_file="$lock_dir/.news-alert.lock"
  exec 201>"$lock_file"
  if ! flock -w 30 201; then
    echo "ERR: news-alert lock 획득 실패 ($lock_file)" >&2
    exit 1
  fi
}

# cron add 후 같은 name cron이 1개 초과면 가장 최근 1개만 keep하고 모두 rm.
# lock으로 막지 못한 매우 좁은 race나 과거 누적된 stale을 수렴 정리.
verify_unique_cron() {
  local job="$1"
  local jobs_json=""
  local attempt
  for attempt in 1 2 3 4 5; do
    if jobs_json=$(openclaw cron list --json 2>/dev/null) && [[ -n "$jobs_json" ]]; then
      break
    fi
    jobs_json=""
    sleep 1
  done
  if [[ -z "$jobs_json" ]]; then
    echo "WARN verify_unique_cron: cron list 실패 — dedupe 검증 건너뜀" >&2
    return 0
  fi

  JOB_NAME="$job" JOBS_JSON="$jobs_json" python3 - <<'PY'
import json, os, subprocess, sys
job = os.environ["JOB_NAME"]
try:
    data = json.loads(os.environ["JOBS_JSON"])
    jobs = data.get("jobs", []) if isinstance(data, dict) else data
except Exception as exc:
    print(f"WARN verify_unique_cron: invalid JSON: {exc}", file=sys.stderr)
    sys.exit(0)
matches = [j for j in jobs if j.get("name") == job]
if len(matches) <= 1:
    sys.exit(0)
matches.sort(key=lambda j: j.get("createdAt") or j.get("created_at") or "")
keep = matches[-1]
for j in matches:
    if j is keep:
        continue
    subprocess.run(
        ["openclaw", "cron", "rm", j.get("id") or j.get("name")],
        check=False, capture_output=True, text=True,
    )
    print(f"verify_unique_cron: removed duplicate {job} id={j.get('id')}", file=sys.stderr)
PY
}

write_subscription_file() {
  local discord_id="$1"
  local cron_expr="$2"
  local sources="$3"
  local out_file="$4"
  local dir
  dir=$(dirname "$out_file")
  mkdir -p "$dir"

  local tmp_file
  tmp_file=$(mktemp "$dir/.news-subscription.XXXXXX")

  if ! DISCORD_ID="$discord_id" CRON_EXPR="$cron_expr" SOURCES="$sources" JOB_NAME="$(job_name "$discord_id")" TMP_FILE="$tmp_file" python3 - <<'PY'
import json
import os
from datetime import datetime, timezone

prefs = {
    "enabled": True,
    "cronExpr": os.environ["CRON_EXPR"],
    "timezone": "Asia/Seoul",
    "sources": [s for s in os.environ["SOURCES"].split(",") if s],
    "cronJobName": os.environ["JOB_NAME"],
    "subscribedAt": datetime.now(timezone.utc).isoformat(),
    "lastSentAt": None,
}

with open(os.environ["TMP_FILE"], "w", encoding="utf-8") as f:
    json.dump(prefs, f, indent=2, ensure_ascii=False)
PY
  then
    rm -f "$tmp_file"
    return 1
  fi

  mv "$tmp_file" "$out_file"
}

update_last_sent_at() {
  local file_path="$1"
  local dir
  dir=$(dirname "$file_path")
  local tmp_file
  tmp_file=$(mktemp "$dir/.news-subscription.XXXXXX")

  if ! FILE_PATH="$file_path" TMP_FILE="$tmp_file" python3 - <<'PY'
import json
import os
from datetime import datetime, timezone

with open(os.environ["FILE_PATH"], encoding="utf-8") as f:
    payload = json.load(f)

payload["lastSentAt"] = datetime.now(timezone.utc).isoformat()

with open(os.environ["TMP_FILE"], "w", encoding="utf-8") as f:
    json.dump(payload, f, indent=2, ensure_ascii=False)
PY
  then
    rm -f "$tmp_file"
    return 1
  fi

  mv "$tmp_file" "$file_path"
}

case "$CMD" in
  subscribe)
    DISCORD_ID="${1-}"
    CRON_EXPR="${2-}"
    SOURCES="${3-}"
    [[ -z "$DISCORD_ID" || -z "$CRON_EXPR" ]] && { usage; exit 1; }

    UDIR=$(user_dir "$DISCORD_ID")
    mkdir -p "$UDIR"

    acquire_user_lock "$DISCORD_ID"

    # 같은 name으로 cron이 누적되는 문제(#duplicate-attendance-alerts)를 막기 위해
    # add 전에 같은 name의 cron을 확실히 제거한다. cron list로 존재 여부를 보고 있을
    # 때만 rm을 시도(없으면 정상). list/rm이 실패하면 add를 막아 누적을 방지한다.
    JOB="$(job_name "$DISCORD_ID")"
    JOBS_JSON=""
    for attempt in 1 2 3 4 5; do
      if JOBS_JSON=$(openclaw cron list --json 2>/dev/null) && [[ -n "$JOBS_JSON" ]]; then
        break
      fi
      JOBS_JSON=""
      sleep 1
    done
    if [[ -z "$JOBS_JSON" ]]; then
      echo "ERR: openclaw cron list 실패. cron 누적 위험으로 subscribe 중단." >&2
      exit 1
    fi

    if JOB_NAME="$JOB" JOBS_JSON="$JOBS_JSON" python3 - <<'PY'
import json, os, subprocess, sys
job = os.environ["JOB_NAME"]
try:
    data = json.loads(os.environ["JOBS_JSON"])
    jobs = data.get("jobs", []) if isinstance(data, dict) else data
except Exception as exc:
    print(f"ERR news subscribe: invalid cron list JSON: {exc}", file=sys.stderr)
    sys.exit(1)
targets = [j for j in jobs if j.get("name") == job]
for t in targets:
    result = subprocess.run(
        ["openclaw", "cron", "rm", t.get("id") or t.get("name")],
        check=False, capture_output=True, text=True,
    )
    if result.returncode != 0:
        print(f"ERR news subscribe: failed to rm {t.get('id') or t.get('name')}: {(result.stderr or result.stdout).strip()}", file=sys.stderr)
        sys.exit(1)
PY
    then
      :
    else
      echo "ERR: 기존 news cron 제거 실패. 누적 방지를 위해 subscribe 중단." >&2
      exit 1
    fi

    printf -v deliver_cmd 'mju-news-alert deliver %q' "$DISCORD_ID"
    MESSAGE="다음을 정확히 실행: exec로 $deliver_cmd 를 실행하고, 추가 명령 없이 <final></final>로 종료."

    if ! openclaw cron add \
      --name "$(job_name "$DISCORD_ID")" \
      --cron "$CRON_EXPR" \
      --tz "Asia/Seoul" \
      --session isolated \
      --message "$MESSAGE" \
      --no-deliver \
      --tools "exec" \
      --timeout-seconds 90 >/dev/null; then
      echo "ERR: failed to register news alert cron for $DISCORD_ID" >&2
      exit 1
    fi

    if ! write_subscription_file "$DISCORD_ID" "$CRON_EXPR" "$SOURCES" "$(subs_file "$DISCORD_ID")"; then
      openclaw cron rm "$(job_name "$DISCORD_ID")" >/dev/null 2>&1 || true
      echo "ERR: failed to write subscription state for $DISCORD_ID" >&2
      exit 1
    fi

    verify_unique_cron "$JOB"

    echo "OK: subscribed $DISCORD_ID to $CRON_EXPR"
    ;;

  preset)
    DISCORD_ID="${1-}"
    PRESET_ID="${2-}"
    SOURCES="${3-}"
    [[ -z "$DISCORD_ID" || -z "$PRESET_ID" ]] && { usage; exit 1; }

    if ! CRON_EXPR=$(preset_cron "$PRESET_ID"); then
      echo "ERR: unknown preset '$PRESET_ID'" >&2
      exit 1
    fi

    if [[ "$PRESET_ID" == "skip" ]]; then
      # skip 프리셋: 기존 구독만 제거하고 subscription 파일은 남기지 않는다.
      acquire_user_lock "$DISCORD_ID"
      openclaw cron rm "$(job_name "$DISCORD_ID")" >/dev/null 2>&1 || true
      rm -f "$(subs_file "$DISCORD_ID")"
      echo "OK: preset skip applied for $DISCORD_ID (no subscription)"
      exit 0
    fi

    exec "$0" subscribe "$DISCORD_ID" "$CRON_EXPR" "$SOURCES"
    ;;

  unsubscribe)
    DISCORD_ID="${1-}"
    [[ -z "$DISCORD_ID" ]] && { usage; exit 1; }
    acquire_user_lock "$DISCORD_ID"
    # 같은 name으로 누적된 cron이 있을 수 있으므로 list 기반 전수 제거.
    JOB="$(job_name "$DISCORD_ID")"
    JOBS_JSON=""
    for attempt in 1 2 3 4 5; do
      if JOBS_JSON=$(openclaw cron list --json 2>/dev/null) && [[ -n "$JOBS_JSON" ]]; then
        break
      fi
      JOBS_JSON=""
      sleep 1
    done
    if [[ -n "$JOBS_JSON" ]]; then
      JOB_NAME="$JOB" JOBS_JSON="$JOBS_JSON" python3 - <<'PY' || true
import json, os, subprocess, sys
job = os.environ["JOB_NAME"]
try:
    data = json.loads(os.environ["JOBS_JSON"])
    jobs = data.get("jobs", []) if isinstance(data, dict) else data
except Exception:
    sys.exit(0)
for j in [x for x in jobs if x.get("name") == job]:
    subprocess.run(
        ["openclaw", "cron", "rm", j.get("id") or j.get("name")],
        check=False, capture_output=True, text=True,
    )
PY
    else
      openclaw cron rm "$(job_name "$DISCORD_ID")" >/dev/null 2>&1 || true
    fi
    rm -f "$(subs_file "$DISCORD_ID")"
    echo "OK: unsubscribed $DISCORD_ID"
    ;;

  status)
    DISCORD_ID="${1-}"
    [[ -z "$DISCORD_ID" ]] && { usage; exit 1; }
    F=$(subs_file "$DISCORD_ID")
    if [[ -f "$F" ]]; then
      cat "$F"
    else
      echo '{"enabled":false}'
    fi
    ;;

  deliver)
    DISCORD_ID="${1-}"
    [[ -z "$DISCORD_ID" ]] && { usage; exit 1; }
    F=$(subs_file "$DISCORD_ID")
    [[ ! -f "$F" ]] && { echo "신규 공지 없음"; exit 0; }

    # 같은 사용자에 대한 deliver 동시 실행 방지. cron이 어떤 이유(중복 등록, retry)로
    # 짧은 시간 안에 두 번 발사되어도, 두 번째는 lock을 못 얻고 바로 exit 한다.
    UDIR=$(user_dir "$DISCORD_ID")
    mkdir -p "$UDIR"
    LOCK_FILE="$UDIR/.news-deliver.lock"
    exec 9>"$LOCK_FILE"
    if ! flock -n 9; then
      exit 0
    fi

    # lastSentAt 기반 쿨다운 — flock을 통과해도 5분 안에 이미 발송한 흔적이 있으면 skip.
    # cron이 같은 시각에 N번 발사되더라도 첫 번째만 발송되도록 하는 안전망.
    if FILE_PATH="$F" python3 - <<'PY'
import json, os, sys
from datetime import datetime, timezone
try:
    with open(os.environ["FILE_PATH"], encoding="utf-8") as f:
        last = json.load(f).get("lastSentAt")
except Exception:
    sys.exit(1)
if not last:
    sys.exit(1)
try:
    dt = datetime.fromisoformat(last.replace("Z", "+00:00"))
except Exception:
    sys.exit(1)
delta = (datetime.now(timezone.utc) - dt.astimezone(timezone.utc)).total_seconds()
sys.exit(0 if delta < 300 else 1)
PY
    then
      exit 0
    fi

    SINCE=$(FILE_PATH="$F" python3 - <<'PY'
import json
import os
from datetime import datetime, timezone, timedelta

with open(os.environ["FILE_PATH"], encoding="utf-8") as f:
    payload = json.load(f)

last = payload.get("lastSentAt")
if last:
    print(last)
else:
    print((datetime.now(timezone.utc) - timedelta(hours=24)).isoformat())
PY
)

    SOURCES=$(FILE_PATH="$F" python3 - <<'PY'
import json
import os

with open(os.environ["FILE_PATH"], encoding="utf-8") as f:
    payload = json.load(f)

print(",".join(payload.get("sources", [])))
PY
)

    # v2.0.0: `new --since` → `notices recent --since`.
    # 카테고리 구독자는 CLI 레벨에서 `--category`를 내려 각 카테고리별로 독립 조회해야
    # "general 50건에 묻힌 scholarship" 같은 누락이 안 생긴다 (issue #4 High-1).
    # 조회 실패는 반드시 exit 1로 전파 — 빈 배열 fallback은 장애를 성공으로 위장한다 (issue #4 High-2).
    STDERR_FILE=$(mktemp "${TMPDIR:-/tmp}/mju-news-alert-stderr.XXXXXX")
    trap 'rm -f "$STDERR_FILE"' EXIT

    if [[ -z "$SOURCES" ]]; then
      categories=("")   # 빈 원소 하나 = 카테고리 필터 없이 한 번만 호출
    else
      IFS=',' read -ra categories <<< "$SOURCES"
    fi

    # 카테고리 수에 비례해 limit을 조정. 단일 전체 조회일 땐 50, 카테고리별이면 각 30건.
    if [[ -z "$SOURCES" ]]; then
      per_call_limit=50
    else
      per_call_limit=30
    fi

    ALL_ITEMS='[]'
    for cat in "${categories[@]}"; do
      if [[ -z "$cat" ]]; then
        mju_args=(notices recent --since "$SINCE" --limit "$per_call_limit" --format json)
      else
        mju_args=(notices recent --category "$cat" --since "$SINCE" --limit "$per_call_limit" --format json)
      fi

      if ! RESULT=$(mju-news "${mju_args[@]}" 2>"$STDERR_FILE"); then
        stderr_text=$(cat "$STDERR_FILE" 2>/dev/null || true)
        echo "ERR: mju-news-alert[$DISCORD_ID] fetch failed (category='${cat:-all}'): ${stderr_text:-<no stderr>}" >&2
        exit 1
      fi

      ALL_ITEMS=$(RESULT_JSON="$RESULT" ACCUM_JSON="$ALL_ITEMS" python3 - <<'PY'
import json
import os

accum = json.loads(os.environ["ACCUM_JSON"])
items = json.loads(os.environ["RESULT_JSON"]).get("items", [])
accum.extend(items)
print(json.dumps(accum, ensure_ascii=False))
PY
)
    done

    CONTENT=$(ITEMS_JSON="$ALL_ITEMS" python3 - <<'PY'
import json
import os
import sys

items = json.loads(os.environ["ITEMS_JSON"])

# 카테고리별 호출 병합 결과에 혹시 남아있을 수 있는 중복(id 기준) 제거.
seen = set()
deduped = []
for item in items:
    key = item.get("id") or (item.get("source"), item.get("externalId"))
    if key in seen:
        continue
    seen.add(key)
    deduped.append(item)
items = deduped

# 최신순 정렬 (publishedAt desc). 빠진 필드 방어.
items.sort(key=lambda it: it.get("publishedAt", ""), reverse=True)

if not items:
    print("신규 공지 없음")
    sys.exit(0)

label = {
    "general": "📢 일반공지",
    "scholarship": "💰 장학/학자금공지",
    "event": "🎉 행사공지",
    "career": "💼 진로/취업공지",
}

by_source = {}
for item in items:
    by_source.setdefault(item.get("source", ""), []).append(item)

lines = [f"🦁 새 학교 공지 {len(items)}건"]
for source, group in by_source.items():
    lines.append("")
    lines.append(f"**{label.get(source, source)}** ({len(group)}건)")
    for notice in group[:5]:
        title = notice.get("title", "")
        url = notice.get("url", "")
        lines.append(f"- [{title}]({url})")

print("\n".join(lines))
PY
)

    if [[ "$CONTENT" == "신규 공지 없음" || -z "$CONTENT" ]]; then
      echo "신규 공지 없음"
      exit 0
    fi

    # OpenClaw discord 채널은 비활성화되어 있고 봇 토큰은 mjuclaw-router가 단독
    # 소유한다. 따라서 outbound DM은 router HTTP `POST /discord/send`로 위임한다.
    ROUTER_URL="${MJUCLAW_ROUTER_URL:-http://mjuclaw-router:3100}"
    ROUTER_TOKEN="${MJUCLAW_ROUTER_TOKEN-}"
    if [[ -z "$ROUTER_TOKEN" ]]; then
      echo "ERR: MJUCLAW_ROUTER_TOKEN env가 비어있어 router로 DM을 보낼 수 없습니다." >&2
      exit 1
    fi

    SEND_BODY=$(DISCORD_ID="$DISCORD_ID" CONTENT="$CONTENT" python3 - <<'PY'
import json, os
print(json.dumps({"discordUserId": os.environ["DISCORD_ID"], "content": os.environ["CONTENT"]}))
PY
)

    HTTP_OUT=$(mktemp "${TMPDIR:-/tmp}/router-send.XXXXXX")
    HTTP_CODE=$(curl -sS -o "$HTTP_OUT" -w "%{http_code}" \
      -X POST "$ROUTER_URL/discord/send" \
      -H "Authorization: Bearer $ROUTER_TOKEN" \
      -H "Content-Type: application/json" \
      --max-time 30 \
      --data-raw "$SEND_BODY" || echo "000")
    if [[ "$HTTP_CODE" != "200" ]]; then
      RESP_BODY=$(cat "$HTTP_OUT" 2>/dev/null || true)
      rm -f "$HTTP_OUT"
      echo "ERR: router /discord/send → HTTP $HTTP_CODE: ${RESP_BODY:-<no body>}" >&2
      exit 1
    fi
    rm -f "$HTTP_OUT"

    if ! update_last_sent_at "$F"; then
      echo "ERR: delivered news alert but failed to update lastSentAt" >&2
      exit 1
    fi

    printf '%s\n' "$CONTENT"
    ;;

  *)
    usage
    exit 1
    ;;
esac
