#!/bin/bash
# mju wrapper: 실제 mju-cli 실행 후 결과를 view-server에 자동 POST하고
# 반환 JSON에 viewUrl 필드를 주입한다. 에이전트는 그냥 출력의 viewUrl만 쓰면 됨.
#
# dataType은 서브커맨드를 보고 자동 매핑:
#   lms +action-items  → action-items
#   lms +unsubmitted   → unsubmitted
#   lms +unread-notices → unread-notices
#   msi timetable      → timetable
#   msi grades         → grades
#   msi graduation     → graduation
#   ucheck ...         → attendance
#   그 외              → generic
#
# view-server POST 실패해도 원본 출력은 그대로 반환 (에이전트 동작 방해 금지).

set -euo pipefail

REAL_MJU="/opt/mju-cli/dist/main.js"
VIEW_API="${VIEW_API_URL:-http://localhost:3001/api/view}"

has_app_dir() {
  local arg
  for arg in "$@"; do
    case "$arg" in
      --app-dir|--app-dir=*) return 0 ;;
    esac
  done
  return 1
}

is_allowed_without_app_dir() {
  local args=("$@")
  local i

  for arg in "${args[@]}"; do
    case "$arg" in
      --help|-h) return 0 ;;
      doctor) return 0 ;;
    esac
  done

  for ((i = 0; i < ${#args[@]} - 1; i++)); do
    if [[ "${args[i]}" == "skills" && "${args[i + 1]}" == "list" ]]; then
      return 0
    fi
  done

  return 1
}

# 서브커맨드에서 dataType 추출
detect_datatype() {
  local args="$*"
  case "$args" in
    *"lms +action-items"*) echo "action-items" ;;
    *"lms +unsubmitted"*) echo "unsubmitted" ;;
    *"lms +unread-notices"*) echo "unread-notices" ;;
    *"lms +digest"*) echo "action-items" ;;
    *"msi timetable"*) echo "timetable" ;;
    *"msi grade-history"*) echo "grade-history" ;;
    *"msi current-grades"*) echo "grades" ;;
    *"msi grades"*) echo "grades" ;;
    *"msi graduation"*) echo "graduation" ;;
    *"lms courses list"*) echo "courses" ;;
    *"ucheck"*) echo "attendance" ;;
    *"ucheck attendance"*) echo "attendance" ;;
    *) echo "" ;;
  esac
}

# 조회성 커맨드 (읽기 only)만 web view 생성 — auth/config 등은 제외
should_view() {
  local args="$*"
  case "$args" in
    *" +"*) return 0 ;;
    *"timetable"*|*"grade-history"*|*"grades"*|*"graduation"*|*"courses list"*|*"attendance"*) return 0 ;;
    *"auth "*|*"config "*|*"doctor"*|*"skills"*) return 1 ;;
    *) return 1 ;;
  esac
}

title_for_datatype() {
  case "$1" in
    "action-items") echo "우선 처리 항목" ;;
    "unsubmitted") echo "미제출 과제" ;;
    "unread-notices") echo "안 읽은 공지" ;;
    "timetable") echo "시간표" ;;
    "grades") echo "성적" ;;
    "grade-history") echo "학기별 성적" ;;
    "graduation") echo "졸업요건" ;;
    "courses") echo "수강과목" ;;
    "attendance") echo "출석" ;;
    *) echo "학사 데이터" ;;
  esac
}

if ! has_app_dir "$@" && ! is_allowed_without_app_dir "$@"; then
  echo "ERR: mju wrapper requires --app-dir to avoid writing to the shared ~/.mju-cli. Pass --app-dir <path>." >&2
  exit 64
fi

STDERR_FILE=$(mktemp "${TMPDIR:-/tmp}/mju-stderr.XXXXXX")
trap 'rm -f "$STDERR_FILE"' EXIT

set +e
STDOUT=$(node "$REAL_MJU" "$@" 2>"$STDERR_FILE")
EXIT=$?
set -e

STDERR=$(cat "$STDERR_FILE" 2>/dev/null || true)

if [[ -n "$STDERR" ]]; then
  printf '%s\n' "$STDERR" >&2
fi

# exit 실패이거나 view 대상 아니면 그냥 pass-through
if [[ $EXIT -ne 0 ]] || ! should_view "$@"; then
  printf '%s\n' "$STDOUT"
  exit "$EXIT"
fi

# JSON이 아니면 그냥 pass-through (table format 등)
case "$*" in
  *"--format json"*|*"--format=json"*) ;;
  *)
    printf '%s\n' "$STDOUT"
    exit "$EXIT"
    ;;
esac

DATA_TYPE=$(detect_datatype "$@")
if [[ -z "$DATA_TYPE" ]]; then
  printf '%s\n' "$STDOUT"
  exit "$EXIT"
fi

TITLE=$(title_for_datatype "$DATA_TYPE")

REQUEST_BODY=$(RAW_STDOUT="$STDOUT" DATA_TYPE="$DATA_TYPE" TITLE="$TITLE" python3 - <<'PY'
import json
import os

raw = os.environ["RAW_STDOUT"]
try:
    data = json.loads(raw)
except Exception:
    data = None

print(json.dumps({
    "dataType": os.environ["DATA_TYPE"],
    "title": os.environ["TITLE"],
    "summary": "",
    "rawData": data,
    "aiResponse": "",
}))
PY
)

set +e
VIEW_RESP=$(curl -s --max-time 3 -X POST "$VIEW_API" \
  -H "Content-Type: application/json" \
  -d "$REQUEST_BODY" 2>/dev/null)
CURL_EXIT=$?
set -e

if [[ $CURL_EXIT -ne 0 ]]; then
  printf '%s\n' "$STDOUT"
  exit "$EXIT"
fi

VIEW_URL=$(VIEW_RESP="$VIEW_RESP" python3 - <<'PY'
import json
import os

try:
    print(json.loads(os.environ["VIEW_RESP"]).get("url", ""))
except Exception:
    pass
PY
)

if [[ -n "$VIEW_URL" ]]; then
  RAW_STDOUT="$STDOUT" VIEW_URL="$VIEW_URL" python3 - <<'PY'
import json
import os

raw = os.environ["RAW_STDOUT"]
view_url = os.environ["VIEW_URL"]

try:
    data = json.loads(raw)
    if isinstance(data, dict):
        data["viewUrl"] = view_url
        print(json.dumps(data, ensure_ascii=False))
    else:
        print(json.dumps({"data": data, "viewUrl": view_url}, ensure_ascii=False))
except Exception:
    print(raw)
PY
else
  printf '%s\n' "$STDOUT"
fi

exit "$EXIT"
